{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@c3/contracts": ["packages/contracts/src"],
      "@c3/foundation": ["packages/foundation/src"],
      "@c3/auth": ["packages/auth/src"],
      "@c3/cloud": ["packages/cloud/src"],
      "@c3/hardware": ["packages/hardware/src"],
      "@c3/provider": ["packages/provider/src"],
      "@c3/discovery": ["packages/discovery/src"],
      "@c3/cluster": ["packages/cluster/src"],
      "@c3/compute": ["packages/compute/src"],
      "@c3/jobs": ["packages/jobs/src"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "files": [],
  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/foundation" },
    { "path": "./packages/auth" },
    { "path": "./packages/cloud" },
    { "path": "./packages/hardware" },
    { "path": "./packages/provider" },
    { "path": "./packages/discovery" },
    { "path": "./packages/cluster" },
    { "path": "./packages/compute" },
    { "path": "./packages/jobs" },
    { "path": "./apps/desktop" }
  ]
}
